#Fonctionnels

WEBUI_URL=https://openwebui.company
WEBUI_SECRET_KEY=<RANDOM>

# PostreSQL

PG_PASS=<RANDOM>
PG_USER=<USER>

ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OAUTH_PROVIDER_NAME=Authentik
OPENID_PROVIDER_URL=https://<authentik-url>/application/o/<App-name>/.well-known/openid-configuration
OAUTH_CLIENT_ID=<Client-ID>
OAUTH_CLIENT_SECRET=<Client-Secret>
OAUTH_SCOPES=openid email profile
OPENID_REDIRECT_URI=https://<open-webui>/oauth/oidc/callback
ENABLE_LOGIN_FORM=false
# Mapping de rôles OAuth (OpenWebUI v0.9.6). Laisser ENABLE_OAUTH_ROLE_MANAGEMENT=false
# pour conserver le comportement actuel. Pour accorder le rôle « user » à TOUTE
# personne authentifiée via le SSO (mono-IdP université/entreprise) :
#   ENABLE_OAUTH_ROLE_MANAGEMENT=true et OAUTH_ALLOWED_ROLES=*
ENABLE_OAUTH_ROLE_MANAGEMENT=false
OAUTH_ROLES_CLAIM=roles
OAUTH_ALLOWED_ROLES=
OAUTH_ADMIN_ROLES=admin

QDRANT_API_KEY=<RANDOM>
RAG_EMBEDDING_MODEL=openrouter/embedding   # Alias LiteLLM (doit exister dans litellm_config.yaml)
QDRANT_COLLECTION=open-webui_knowledge     # Collection interrogée par l'agent rag

# MCP (mcpo)

# Timeout (secondes) du handshake d'init MCP côté OpenWebUI (v0.9.6). Généreux car
# mcpo démarre plusieurs serveurs en cascade (playwright lent en dernier).
MCP_INITIALIZE_TIMEOUT=30
PUBMED_API_KEY=              # Optionnel — améliore le rate limit PubMed (3→10 req/s)
SEMANTIC_SCHOLAR_API_KEY=    # Optionnel — améliore les quotas Semantic Scholar
WOS_API_KEY=                 # Optionnel — requis pour Web of Science dans paper-search
WOS_API_VERSION=v1           # v1 recommandé

# Open Terminal

OPEN_TERMINAL_API_KEY=<RANDOM>
OPEN_TERMINAL_URL=http://open-terminal:8000

# LiteLLM

LITELLM_MASTER_KEY=<RANDOM>
LITELLM_SALT_KEY=<RANDOM>
LITELLM_IMAGE=ghcr.io/berriai/litellm:latest
LITELLM_PLATFORM=linux/amd64   # Mettre linux/arm64 sur machine ARM
STORE_MODEL_IN_DB=False         # Mettre True uniquement après migrations LiteLLM appliquées
#Administration LiteLLM
LITELLM_UI_USERNAME=<ADMIN>
LITELLM_UI_PASSWORD=<RANDOM>

# Clés fournisseurs (toutes optionnelles, selon usage)

OPENROUTER_API_KEY=
OPENROUTER_API_BASE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

POLLINATIONS_API_KEY=

# OIKB — synchronisation des bases de connaissances (service opt-in, profile "oikb")

OIKB_API_KEY=               # Clé API OpenWebUI (Settings → Account → API Keys, sk-...)
OIKB_KB_ID=                 # UUID de la base de connaissances à synchroniser
OIKB_SOURCE_DIR=./oikb/docs # Répertoire local source (monté en lecture seule sur /docs)
#OIKB_CMD=oikb daemon       # Surcharger pour un mode ponctuel, cf. compose.yaml

# Pipelines (Alyx — LangGraph multi-agent)

PIPELINES_API_KEY=<RANDOM>
CONTEXT7_API_KEY=
# Optionnel — clé API Open WebUI (Settings → Account → API Keys) permettant à
# l'agent writer d'uploader ses documents en pièce jointe native (event `files`)
# au lieu d'un lien data-URI. Laisser vide pour conserver le comportement data-URI.
WEBUI_API_KEY=